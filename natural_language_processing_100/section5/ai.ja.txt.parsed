            "pos": "形状詞",
            "pos1": "助動詞語幹"
          },
          {
            "surface": "な",
            "base": "だ",
            "pos": "助動詞",
            "pos1": "*"
          }
        ]
      },
      {
        "id": 2,
        "text": "循環構造は、",
        "dst": 5,
        "morphs": [
          {
            "surface": "循環",
            "base": "循環",
            "pos": "名詞",
            "pos1": "普通名詞"
